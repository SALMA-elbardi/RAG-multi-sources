# ==============================================================================
# Variables d'environnement - RAG Multi-Sources & MLOps (Ollama Local)
# ==============================================================================

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=rag-monolith-experiments

# LLM Local (Ollama)
# En local (hors Docker) : http://localhost:11434
# Depuis un conteneur Docker : http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./vector_store

# Ingestion & Documents
DATA_DIRECTORY=./data
